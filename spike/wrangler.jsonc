{
  "name": "studio-spike",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/studio/api/*", "/studio", "/studio/"] },
  "d1_databases": [{ "binding": "DB", "database_name": "studio-spike", "database_id": "local-only", "migrations_dir": "worker/migrations" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "https://example.cloudflareaccess.com", "ACCESS_AUD": "spike-aud", "DEV_TRUST_EMAIL": "dev@example.com" }
}
