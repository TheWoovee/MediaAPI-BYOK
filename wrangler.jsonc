{
  "name": "mediaapi-byok",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/studio/api/*", "/studio", "/studio/"]
  },
  // PROBE routes — use these first to test that a Worker route intercepts on the Pages custom domain.
  // Once confirmed, comment these out and uncomment the /studio routes below.
  "routes": [
    { "pattern": "www.thewoovee.com/__studio-probe",  "zone_name": "thewoovee.com" },
    { "pattern": "www.thewoovee.com/__studio-probe/*", "zone_name": "thewoovee.com" }
  ],
  // PRODUCTION routes — uncomment after the probe succeeds:
  // "routes": [
  //   { "pattern": "www.thewoovee.com/studio",  "zone_name": "thewoovee.com" },
  //   { "pattern": "www.thewoovee.com/studio/*", "zone_name": "thewoovee.com" }
  // ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mediaapi-byok",
      "database_id": "local-only",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TMP",
      "bucket_name": "mediaapi-byok-tmp"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://thewoovee.cloudflareaccess.com",
    "ACCESS_AUD": "<aud>"
  },
  "observability": {
    "enabled": true
  }
}
