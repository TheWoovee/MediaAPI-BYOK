{
  "name": "mediaapi-byok",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/studio/api/*", "/studio", "/studio/"]
  },
  // Worker routes on the existing Pages host. Deploying these IS the routing probe: if
  // https://www.thewoovee.com/studio/api/health returns JSON the route intercepts in front of Pages;
  // if it returns the Pages 404 page, switch to a studio.thewoovee.com custom domain (docs/setup-cloudflare.md §7).
  "routes": [
    { "pattern": "www.thewoovee.com/studio",  "zone_name": "thewoovee.com" },
    { "pattern": "www.thewoovee.com/studio/*", "zone_name": "thewoovee.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mediaapi-byok",
      "database_id": "4776d0cc-5a07-4704-8466-6bd234f92f6f",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TMP",
      "bucket_name": "mediaapi-byok-tmp"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://thewoovee.cloudflareaccess.com",
    "ACCESS_AUD": "<aud>",
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
